# 复制为 keystore.properties 后填入正式签名信息（该文件已被 .gitignore 忽略）
# 配置后先运行:
#   python3 tools/update_expected_cert.py <keystore> <alias> <storePassword>
# 把正式证书 SHA-256 写进 native 门禁；否则 release 包的模块 App 内 native 初始化会被拒绝
storeFile=/absolute/path/to/release.jks
storePassword=change_me
keyAlias=release
keyPassword=change_me
