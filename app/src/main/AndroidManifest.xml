<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 跨进程控制广播仅允许同签名应用发送 -->
    <permission
        android:name="com.keyscafe.unlock.permission.INTERNAL"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.keyscafe.unlock.permission.INTERNAL" />

    <application
        android:name=".XyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.KeysCafeUnlock">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Xposed 远程服务 Provider -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.keyscafe.unlock.XposedService"
            android:exported="true" />

        <!-- Xposed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="三星键盘增强" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>
</manifest>
